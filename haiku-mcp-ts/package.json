{
  "name": "@stiglau/komposteur-mcp-server",
  "version": "1.0.0-beta.1",
  "description": "Cost-optimized MCP server using Haiku/Gemini Flash for FFMPEG operations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "haiku-mcp-server": "./bin/server.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./lib": "./dist/lib/index.js", 
    "./server": "./dist/server.js",
    "./bin": "./bin/server.js"
  },
  "files": [
    "dist/**/*",
    "bin/**/*",
    "README.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "tsc && bun run build:lib",
    "build:lib": "mkdir -p dist/lib && cp dist/tools/* dist/registry/* dist/llm/* dist/lib/ 2>/dev/null || true",
    "dev": "bun --watch src/server.ts",
    "start": "bun dist/server.js",
    "test": "bun test || echo 'No tests found - skipping'",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist",
    "package": "bun run clean && bun run build && bun run test",
    "prepublishOnly": "bun run package"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kompo-ai/haiku-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "ffmpeg",
    "haiku",
    "gemini",
    "video",
    "cost-optimization"
  ],
  "author": "YOLO-FFMPEG-MCP",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@anthropic-ai/sdk": "^0.27.0",
    "@google/generative-ai": "^0.18.0",
    "yaml": "^2.8.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  }
}